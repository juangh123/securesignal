    "hardhat": "^2.28.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@flarenetwork/flare-periphery-contracts": "^0.1.52",
    "@openzeppelin/contracts": "^4.9.6",
    "dotenv": "^17.4.2",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22",
    "node-fetch": "^3.3.2"
  },
  "directories": {
    "test": "test"
